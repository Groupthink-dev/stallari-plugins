{
  "$id": "https://stallari.app/schemas/contracts/email-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Email service contract v1 — 15 operations across search, read, manage, and write. v4.5 +2 ops (flag_bitmask_get/set) for JMAP keyword-bitmask portability (DD-344 Phase A.4).",
  "operations": [
    {
      "classification": "required",
      "description": "Search messages by query, folder, date range",
      "name": "search"
    },
    {
      "classification": "required",
      "description": "Read full message content",
      "name": "read"
    },
    {
      "classification": "required",
      "description": "List available mailboxes/folders",
      "name": "mailboxes"
    },
    {
      "classification": "recommended",
      "description": "Token-efficient message previews",
      "name": "snippets"
    },
    {
      "classification": "recommended",
      "description": "Thread-grouped message view",
      "name": "threads"
    },
    {
      "classification": "optional",
      "description": "Protocol state for incremental sync",
      "name": "state"
    },
    {
      "classification": "optional",
      "description": "Incremental change tracking",
      "name": "changes"
    },
    {
      "classification": "optional",
      "description": "Batch operations",
      "name": "bulk"
    },
    {
      "classification": "gated",
      "description": "Compose and send a message",
      "name": "send"
    },
    {
      "classification": "gated",
      "description": "Reply to a message",
      "name": "reply"
    },
    {
      "classification": "gated",
      "description": "Set/clear simple flags on messages (read/unread, flagged/unflagged)",
      "name": "flag"
    },
    {
      "classification": "recommended",
      "description": "Read JMAP keyword bitmask for a message (e.g. Apple Mail $MailFlagBit0..$MailFlagBit6 colour-coded flags)",
      "name": "flag_bitmask_get"
    },
    {
      "classification": "gated",
      "description": "Set JMAP keyword bitmask on a message; atomic add/remove via decimal bitmask or keyword arrays",
      "name": "flag_bitmask_set"
    },
    {
      "classification": "gated",
      "description": "Move messages between folders",
      "name": "move"
    },
    {
      "classification": "gated",
      "description": "Delete a message",
      "name": "delete"
    }
  ],
  "properties": {
    "name": {
      "const": "email-v1"
    },
    "service": {
      "const": "email"
    },
    "version": {
      "const": 1
    }
  },
  "title": "email-v1",
  "type": "object"
}
